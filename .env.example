# Copy this file to ".env" and fill in. Never upload .env to GitHub.
# Use the free Groq cloud API instead of Ollama (no download, no RAM needed):
TRUSTCHECK_PROVIDER=groq
GROQ_API_KEY=paste_your_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Set to 1 when you host the website for other people: hides the developer settings
# (AI backend, model, analysis mode) so visitors can't switch to a backend that isn't set up.
TRUSTCHECK_PUBLIC=0
